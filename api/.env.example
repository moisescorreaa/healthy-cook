# Copie para .env e ajuste. O .env não é versionado.
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=healthy_cook
DB_USER=healthy_cook
DB_PASSWORD=healthy_cook

# Gere um segredo forte: openssl rand -base64 48
JWT_SECRET=troque-este-segredo
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

UPLOADS_DIR=public/uploads

# Origens do app web liberadas para CORS (separadas por vírgula).
# Em desenvolvimento, * libera qualquer porta do `flutter run -d chrome`.
CORS_ALLOWED_ORIGINS=*
